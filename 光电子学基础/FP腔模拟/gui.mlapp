classdef fp < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure              matlab.ui.Figure
        Panel                 matlab.ui.container.Panel
        Phi2EditField         matlab.ui.control.NumericEditField
        EditField_4Label      matlab.ui.control.Label
        Theta2EditField       matlab.ui.control.NumericEditField
        EditField_3Label      matlab.ui.control.Label
        d2EditField           matlab.ui.control.NumericEditField
        dnmEditField_2Label   matlab.ui.control.Label
        n2EditField           matlab.ui.control.NumericEditField
        nEditField_2Label     matlab.ui.control.Label
        r2EditField           matlab.ui.control.NumericEditField
        rEditField_2Label     matlab.ui.control.Label
        A2EditField           matlab.ui.control.NumericEditField
        AEditField_2Label     matlab.ui.control.Label
        Phi1EditField         matlab.ui.control.NumericEditField
        Label_5               matlab.ui.control.Label
        Theta1EditField       matlab.ui.control.NumericEditField
        Label_4               matlab.ui.control.Label
        d1EditField           matlab.ui.control.NumericEditField
        dnmEditFieldLabel     matlab.ui.control.Label
        n1EditField           matlab.ui.control.NumericEditField
        nEditFieldLabel       matlab.ui.control.Label
        r1EditField           matlab.ui.control.NumericEditField
        rEditFieldLabel       matlab.ui.control.Label
        A1EditField           matlab.ui.control.NumericEditField
        AEditFieldLabel       matlab.ui.control.Label
        LengthStepEditField   matlab.ui.control.NumericEditField
        nmEditField_3Label    matlab.ui.control.Label
        LengthUpperEditField  matlab.ui.control.NumericEditField
        Label_2               matlab.ui.control.Label
        LengthLowerEditField  matlab.ui.control.NumericEditField
        Label                 matlab.ui.control.Label
        Label_6               matlab.ui.control.Label
        Label_3               matlab.ui.control.Label
        ShowCurveButton       matlab.ui.control.Button
        SaveImageButton       matlab.ui.control.Button
        CalculateButton       matlab.ui.control.Button
        ImagePanel            matlab.ui.container.Panel
        UIAxes                matlab.ui.control.UIAxes
    end

    % Callbacks that handle component events
    methods (Access = private)

        % Button pushed function: CalculateButton
        function Calculate(app, event)
            % 从第一组编辑字段中读取参数
            A1 = app.A1EditField.Value;          % 吸收损耗
            r1 = app.r1EditField.Value;          % 反射率
            n1 = app.n1EditField.Value;          % 介质折射率
            d1 = app.d1EditField.Value;          % 谐振腔厚度（单位：纳米）
            theta1 = app.Theta1EditField.Value;  % 入射角（单位：度）
            phi1 = app.Phi1EditField.Value;      % 相位偏移（单位：弧度）

            % 从第二组编辑字段中读取参数
            A2 = app.A2EditField.Value;          % 吸收损耗
            r2 = app.r2EditField.Value;          % 反射率
            n2 = app.n2EditField.Value;          % 介质折射率
            d2 = app.d2EditField.Value;          % 谐振腔厚度（单位：纳米）
            theta2 = app.Theta2EditField.Value;  % 入射角（单位：度）
            phi2 = app.Phi2EditField.Value;      % 相位偏移（单位：弧度）

            % 从波长范围和步长字段中读取参数
            lambda_min = app.LengthLowerEditField.Value; % 波长范围下界
            lambda_max = app.LengthUpperEditField.Value; % 波长范围上界
            step = app.LengthStepEditField.Value;        % 波长步长

            % 检查参数有效性
            if lambda_min >= lambda_max || step <= 0
                uialert(app.UIFigure, '波长范围或步长设置不正确！', '参数错误');
                return;
            end

            if A1 < 0 || A1 > 1 || A2 < 0 || A2 > 1
                uialert(app.UIFigure, '吸收损耗必须在0到1之间！', '参数错误');
                return;
            end

            if r1 < 0 || r1 > 1 || r2 < 0 || r2 > 1
                uialert(app.UIFigure, '反射率必须在0到1之间！', '参数错误');
                return;
            end

            if d1 <= 0 || d2 <= 0
                uialert(app.UIFigure, '谐振腔厚度必须大于0！', '参数错误');
                return;
            end

            if n1 < 1 || n2 < 1
                uialert(app.UIFigure, '介质折射率必须大于等于1！', '参数错误');
                return;
            end

            if theta1 < 0 || theta1 > 90 || theta2 < 0 || theta2 > 90
                uialert(app.UIFigure, '入射角必须在0到90度之间！', '参数错误');
                return;
            end




            % 波长范围
            lambda_range = lambda_min:step:lambda_max;

            % 初始化透射率数组
            T_values1 = zeros(size(lambda_range));
            T_values2 = zeros(size(lambda_range));

            % 将角度转换为弧度
            theta1_rad = deg2rad(theta1);
            theta2_rad = deg2rad(theta2);

            % 计算第一组参数的透射率
            for i = 1:length(lambda_range)
                lambda = lambda_range(i);
                % 公式中的光程部分
                optical_path1 = n1 * d1 * cos(theta1_rad);
                % 计算相位差
                phase_difference1 = (2 * pi / lambda) * optical_path1 - phi1;
                % 计算透射率 T
                denominator1 = 1 + (4 * r1 / (1 - r1)^2) * sin(phase_difference1)^2;
                T_values1(i) = (1 - (A1 / (1 - r1)))^2 * (1 / denominator1);
            end

            % 计算第二组参数的透射率
            for i = 1:length(lambda_range)
                lambda = lambda_range(i);
                % 公式中的光程部分
                optical_path2 = n2 * d2 * cos(theta2_rad);
                % 计算相位差
                phase_difference2 = (2 * pi / lambda) * optical_path2 - phi2;
                % 计算透射率 T
                denominator2 = 1 + (4 * r2 / (1 - r2)^2) * sin(phase_difference2)^2;
                T_values2(i) = (1 - (A2 / (1 - r2)))^2 * (1 / denominator2);
            end

            % 在 UIAxes 上绘制两条曲线
            plot(app.UIAxes, lambda_range, T_values1, 'b-', 'LineWidth', 1.5); % 第一条曲线（蓝色）
            hold(app.UIAxes, 'on');
            plot(app.UIAxes, lambda_range, T_values2, 'r-', 'LineWidth', 1.5); % 第二条曲线（红色）
            hold(app.UIAxes, 'off');

            % 设置图表属性
            xlabel(app.UIAxes, '波长 (nm)');
            ylabel(app.UIAxes, '透射率 T');
            title(app.UIAxes, 'FP谐振器透射率随波长的变化');
            legend(app.UIAxes, {'曲线1', '曲线2'}, 'Location', 'best');
            grid(app.UIAxes, 'on');
        end
        % Button pushed function: SaveImageButton
        function SaveImage(app, event)
            % 弹出保存文件对话框，选择保存路径和文件名
            [file, path] = uiputfile({'*.png'; '*.jpg'; '*.tif'; '*.pdf'}, '保存图像');
            
            % 如果用户取消保存操作，则直接返回
            if isequal(file, 0) || isequal(path, 0)
                return;
            end
            
            % 构造完整的文件路径
            fullFileName = fullfile(path, file);
            
            % 创建一个新的不可见的图形窗口
            fig = figure('Visible', 'off');
            
            % 复制 UIAxes 的内容到新图形窗口
            ax = copyobj(app.UIAxes, fig);
            set(ax, 'Units', 'normalized', 'Position', [0.13, 0.11, 0.775, 0.815]); % 调整轴的位置
            
            % 保存图像到指定路径
            saveas(fig, fullFileName);
            
            % 关闭临时图形窗口
            close(fig);
            
            % 弹出提示框，通知用户保存成功
            uialert(app.UIFigure, '图像已成功保存！', '保存成功');
        end

        % Button pushed function: ShowCurveButton
        function ShowCurve(app, event)

            
        end
    end

    % Component initialization
    methods (Access = private)

        % Create UIFigure and components
        function createComponents(app)

            % Create UIFigure and hide until all components are created
            app.UIFigure = uifigure('Visible', 'off');
