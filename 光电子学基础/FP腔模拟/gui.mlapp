            app.Label.HorizontalAlignment = 'right';
            app.Label.Position = [25 10 102 22];
            app.Label.Text = '波长范围下界(nm)';

            % Create LengthLowerEditField
            app.LengthLowerEditField = uieditfield(app.Panel, 'numeric');
            app.LengthLowerEditField.Position = [142 10 100 22];

            % Create Label_2
