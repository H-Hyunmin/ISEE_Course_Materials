            app.A1EditField.Position = [95 177 53 23];

            % Create rEditFieldLabel
            app.rEditFieldLabel = uilabel(app.Panel);
            app.rEditFieldLabel.HorizontalAlignment = 'right';
            app.rEditFieldLabel.Position = [208 178 45 22];
            app.rEditFieldLabel.Text = '反射率r';

            % Create r1EditField
            app.r1EditField = uieditfield(app.Panel, 'numeric');
            app.r1EditField.Position = [268 178 52 22];

            % Create nEditFieldLabel
            app.nEditFieldLabel = uilabel(app.Panel);
            app.nEditFieldLabel.HorizontalAlignment = 'right';
            app.nEditFieldLabel.Position = [381 178 72 22];
            app.nEditFieldLabel.Text = '介质折射率n';

            % Create n1EditField
            app.n1EditField = uieditfield(app.Panel, 'numeric');
