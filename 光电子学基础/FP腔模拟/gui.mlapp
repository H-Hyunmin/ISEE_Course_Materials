            % Create CalculateButton
            app.CalculateButton = uibutton(app.Panel, 'push');
            app.CalculateButton.ButtonPushedFcn = createCallbackFcn(app, @Calculate, true);
            app.CalculateButton.Position = [861 9 100 23];
