            app.nmEditField_3Label.HorizontalAlignment = 'right';
            app.nmEditField_3Label.Position = [502 10 78 22];
            app.nmEditField_3Label.Text = '计算步长(nm)';

            % Create LengthStepEditField
            app.LengthStepEditField = uieditfield(app.Panel, 'numeric');
            app.LengthStepEditField.Position = [595 10 100 22];

            % Create AEditFieldLabel
            app.AEditFieldLabel = uilabel(app.Panel);
            app.AEditFieldLabel.HorizontalAlignment = 'right';
            app.AEditFieldLabel.Position = [25 178 61 22];
            app.AEditFieldLabel.Text = '吸收损耗A';

            % Create A1EditField
